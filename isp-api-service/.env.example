# HTTP
PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database (shared dengan isp-billing-service)
DATABASE_URL=postgres://postgres:GANTI_PASSWORD@localhost:5432/isp_billing

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Dasar URL tautan tagihan publik (PRD v3.0) — harus sama dengan isp-billing-service
PUBLIC_BASE_URL=http://localhost:5173

# isp-billing-service (untuk minta buka isolir saat pembayaran di-approve)
BILLING_BASE_URL=http://localhost:8081
# Shared secret untuk endpoint internal billing-service. WAJIB sama dengan INTERNAL_SECRET di sana.
INTERNAL_SECRET=change-me-to-another-long-random-string

# Upload bukti transfer.
# Dev (native): ./var/uploads relatif ke folder service.
# Produksi (container): pakai path absolut yang di-mount ke Docker volume
# agar bukti tidak hilang saat container di-recreate (PRD US-02 AC3 / §5):
#   UPLOAD_DIR=/var/lib/isp/uploads   + volume "uploads-data:/var/lib/isp/uploads"
UPLOAD_DIR=./var/uploads
UPLOAD_MAX_BYTES=2097152

# Email — kosongkan SMTP_HOST agar fallback log ke console (dev).
# Opsi termudah untuk dev: MailHog via Docker (docker compose up -d) —
#   SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_USER=, SMTP_PASS= (kosong)
#   lalu buka http://localhost:8025 untuk melihat email yang tertangkap.
# Contoh Gmail (kirim ke inbox asli, butuh App Password + 2FA):
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<akun@gmail.com>,
#   SMTP_PASS=<app-password-16-digit>

# Contoh Elastic Email (SMTP relay):
#   SMTP_HOST=smtp.elasticemail.com
#   SMTP_PORT=2525                 # STARTTLS — jangan 465 (implicit TLS)
#   SMTP_SECURE=false
#   SMTP_USER=<email-akun-elastic-email>
#   SMTP_PASS=<elastic-email-api-key>
#   EMAIL_FROM="ISP <no-reply@domain-terverifikasi-anda>"   # From wajib sender/domain terverifikasi
EMAIL_FROM="ISP <no-reply@isp.local>"
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Rate limit (PRD §10). Kosongkan untuk pakai default.
LOGIN_RATE_WINDOW_MS=900000   # 15 menit
LOGIN_RATE_MAX=10             # maks percobaan login gagal per IP
EMAIL_RATE_WINDOW_MS=3600000  # 1 jam
EMAIL_RATE_MAX=20             # maks aksi pemicu email per IP
# Set ke 1 bila berjalan di belakang reverse proxy (nginx) agar IP klien terbaca benar
TRUST_PROXY=

# Logging
LOG_LEVEL=info
NODE_ENV=development

# WhatsApp (Wablas) — kanal notifikasi utama PRD v3.0.
# Kosongkan WABLAS_TOKEN untuk menonaktifkan kanal WhatsApp.
# Auth: header "Authorization: {token}.{secret}" ke POST {base}/api/send-message
WABLAS_BASE_URL=https://smg.wablas.com
WABLAS_TOKEN=
WABLAS_SECRET=
