# =====================================================================
# Konfigurasi produksi untuk docker-compose.prod.yml
#   cp .env.prod.example .env.prod   → isi semua nilai, JANGAN di-commit
#
# Generate secret acak (jalankan 3x untuk JWT/INTERNAL/WEBHOOK):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =====================================================================

TZ=Asia/Jakarta

# --- Database ---
POSTGRES_USER=isp
POSTGRES_PASSWORD=GANTI_PASSWORD_KUAT
POSTGRES_DB=isp_billing

# --- Secret (WAJIB diganti, jangan pakai nilai dev) ---
JWT_SECRET=GANTI_dengan_hasil_randomBytes_48
JWT_EXPIRES_IN=12h
INTERNAL_SECRET=GANTI_dengan_hasil_randomBytes_48
WEBHOOK_SECRET=GANTI_dengan_hasil_randomBytes_48

# --- Domain / URL publik ---
# CORS_ORIGINS = origin frontend Cloudflare. Harus PERSIS: pakai https://,
# tanpa garis miring di akhir. Pisahkan koma bila lebih dari satu.
CORS_ORIGINS=https://billdesk.domain-anda.com

# PUBLIC_BASE_URL = dasar tautan tagihan yang dikirim ke pelanggan lewat
# WhatsApp/email, mis. https://billdesk.domain-anda.com/tagihan/<token>
#
# ⚠ WAJIB DIISI. Bila kosong, aplikasi jatuh ke http://localhost:5173 dan
# SETIAP tautan tagihan tidak bisa dibuka pelanggan — tanpa pesan error apa pun.
PUBLIC_BASE_URL=https://billdesk.domain-anda.com

# URL backend yang di-bake ke bundle frontend saat build.
# Mengubah nilai ini berarti frontend WAJIB di-build ulang di Cloudflare.
VITE_API_BASE_URL=https://billdesk-api.domain-anda.com
VITE_BILLING_BASE_URL=https://billdesk-net.domain-anda.com

# --- Port yang di-expose ke host (di belakang nginx/reverse proxy) ---
API_PORT=8080
BILLING_PORT=8081
FRONTEND_PORT=8090

# --- Rekening tujuan transfer (tampil di portal) ---
VITE_BANK_NAME=BCA
VITE_BANK_ACCOUNT=5440281
VITE_BANK_HOLDER=JITU

# --- Email (SMTP) ---
EMAIL_FROM="ISP Billing <no-reply@domain-anda.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=akun@gmail.com
SMTP_PASS=app-password-16-digit
# Tujuan alert operasional (mis. Mikrotik tak terjangkau)
ALERT_EMAIL=admin@domain-anda.com

# --- WhatsApp (Wablas) — kanal notifikasi utama ---
# Kosongkan WABLAS_TOKEN untuk mematikan kanal WhatsApp (email tetap jalan).
# Perangkat harus tersambung di dashboard Wablas, jika tidak API menolak
# dengan "device disconnected, need to scan qr code again".
WABLAS_BASE_URL=https://smg.wablas.com
WABLAS_TOKEN=
WABLAS_SECRET=

# --- Mikrotik RouterOS ---
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=GANTI
# true = pakai provider mock (tanpa router). Produksi harus false.
MIKROTIK_MOCK=false

# --- Admin pertama (dipakai `run --rm billing seed-admin`) ---
SEED_ADMIN_EMAIL=admin@domain-anda.com
SEED_ADMIN_PASSWORD=GANTI_PASSWORD_KUAT
SEED_ADMIN_NAME=Super Admin

# --- Lain-lain ---
UPLOAD_MAX_BYTES=2097152
TRUST_PROXY=1
LOG_LEVEL=info

# --- Email via Gmail API (HTTPS 443) ---
GMAIL_CLIENT_ID=...apps.googleusercontent.com
GMAIL_CLIENT_SECRET=...
GMAIL_REFRESH_TOKEN=1//...
GMAIL_SENDER=mbah.noname@gmail.com