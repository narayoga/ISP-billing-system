# =====================================================================
# Konfigurasi produksi untuk docker-compose.prod.yml
#   cp .env.prod.example .env.prod   → isi semua nilai, JANGAN di-commit
#
# Generate secret acak (jalankan 3x untuk JWT/INTERNAL/WEBHOOK):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =====================================================================

TZ=Asia/Jakarta

# --- Database ---
POSTGRES_USER=isp
POSTGRES_PASSWORD=GANTI_PASSWORD_KUAT
POSTGRES_DB=isp_billing

# --- Secret (WAJIB diganti, jangan pakai nilai dev) ---
JWT_SECRET=GANTI_dengan_hasil_randomBytes_48
JWT_EXPIRES_IN=12h
INTERNAL_SECRET=GANTI_dengan_hasil_randomBytes_48
WEBHOOK_SECRET=GANTI_dengan_hasil_randomBytes_48

# --- Domain / URL publik ---
# CORS_ORIGINS = origin frontend (pisahkan koma bila lebih dari satu)
CORS_ORIGINS=https://portal.domain-anda.com
PORTAL_BASE_URL=https://portal.domain-anda.com
# URL yang di-bake ke bundle frontend saat build (ubah = harus build ulang)
VITE_API_BASE_URL=https://api.domain-anda.com
VITE_BILLING_BASE_URL=https://billing.domain-anda.com

# --- Port yang di-expose ke host (di belakang nginx/reverse proxy) ---
API_PORT=8080
BILLING_PORT=8081
FRONTEND_PORT=8090

# --- Rekening tujuan transfer (tampil di portal) ---
VITE_BANK_NAME=BCA
VITE_BANK_ACCOUNT=5440281
VITE_BANK_HOLDER=JITU

# --- Email (SMTP) ---
EMAIL_FROM="ISP Billing <no-reply@domain-anda.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=akun@gmail.com
SMTP_PASS=app-password-16-digit
# Tujuan alert operasional (mis. Mikrotik tak terjangkau)
ALERT_EMAIL=admin@domain-anda.com

# --- Mikrotik RouterOS ---
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=GANTI
# true = pakai provider mock (tanpa router). Produksi harus false.
MIKROTIK_MOCK=false

# --- Admin pertama (dipakai `run --rm billing seed-admin`) ---
SEED_ADMIN_EMAIL=admin@domain-anda.com
SEED_ADMIN_PASSWORD=GANTI_PASSWORD_KUAT
SEED_ADMIN_NAME=Super Admin

# --- Lain-lain ---
UPLOAD_MAX_BYTES=2097152
TRUST_PROXY=1
LOG_LEVEL=info
