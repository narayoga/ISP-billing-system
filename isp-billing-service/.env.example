# HTTP server
PORT=8081
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database (PostgreSQL 18)
DATABASE_URL=postgres://postgres:GANTI_PASSWORD@localhost:5432/isp_billing?sslmode=disable

# Dasar URL tautan tagihan publik (PRD v3.0) — dipakai menyusun tautan di notifikasi
PUBLIC_BASE_URL=http://localhost:5173

# JWT — WAJIB sama persis dengan JWT_SECRET di isp-api-service.
# Dipakai untuk memverifikasi token admin pada endpoint terproteksi (mis. generate manual).
JWT_SECRET=change-me-to-a-long-random-string

# Redis (kosongkan → fallback in-memory). Via Docker: docker compose up -d
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# Mikrotik RouterOS API
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
# Paksa pakai provider mock (dev tanpa router). Otomatis mock juga bila MIKROTIK_HOST kosong.
MIKROTIK_MOCK=true

# Webhook receiver secret (untuk endpoint /webhook/network-status)
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Shared secret untuk endpoint internal yang dipanggil isp-api-service (mis. reaktivasi PPPoE).
INTERNAL_SECRET=change-me-to-another-long-random-string

# Email (untuk notifikasi tagihan terbit & reminder). Kosongkan SMTP_HOST → log ke console.
# Contoh Elastic Email: SMTP_HOST=smtp.elasticemail.com, SMTP_PORT=2525 (STARTTLS),
# SMTP_USER=<email-akun>, SMTP_PASS=<api-key>, EMAIL_FROM dari domain terverifikasi.
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ISP <no-reply@isp.local>"
# Tujuan alert operasional (mis. Mikrotik tak terjangkau saat isolir/reaktivasi)
ALERT_EMAIL=

# Logging
LOG_LEVEL=info

# Seed admin (dipakai hanya saat menjalankan `go run ./cmd/seed-admin`)
SEED_ADMIN_EMAIL=admin@isp.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Super Admin
